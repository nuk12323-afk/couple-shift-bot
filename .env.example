# ====================================================
# LINE Messaging API Credentials
# ดูได้จาก LINE Developers Console (https://developers.line.biz)
# ====================================================
LINE_CHANNEL_ACCESS_TOKEN="YOUR_LINE_CHANNEL_ACCESS_TOKEN_HERE"
LINE_CHANNEL_SECRET="YOUR_LINE_CHANNEL_SECRET_HERE"

# LINE User ID หรือ Group ID ที่ต้องการให้ส่งแจ้งเตือน
# (เมื่อคุณทักแชทหาบอท หรือดึงบอทเข้ากลุ่ม ระบบจะตรวจพบและบันทึกให้อัตโนมัติด้วย)
TARGET_LINE_ID=""

# ====================================================
# Typhoon OCR API Credentials
# สมัครรับ API Key ได้ฟรีที่ https://opentyphoon.ai
# ====================================================
TYPHOON_API_KEY="YOUR_TYPHOON_API_KEY_HERE"
TYPHOON_BASE_URL="https://api.opentyphoon.ai/v1"
TYPHOON_OCR_MODEL="typhoon-ocr"
TYPHOON_CHAT_MODEL="typhoon-v1.5x-70b-instruct"

# ====================================================
# ระบบแจ้งเตือนประจำวัน (ตั้งค่าตามที่คุณต้องการ)
# ====================================================
DAILY_REMINDER_TIME="07:30"
TIMEZONE="Asia/Bangkok"

# ชื่อของคุณและแฟน (ตั้งให้ตรงกับในใบตารางเวรเพื่อให้ OCR จับคู่ถูก)
USER1_NAME="ฉัน"
USER2_NAME="แฟน"
